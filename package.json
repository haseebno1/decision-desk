{
  "name": "decision-desk",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first decision tool: weigh criteria against options, get a transparent recommendation, and learn from how it turned out.",
  "license": "MIT",
  "author": {
    "name": "Abdul Haseeb",
    "url": "https://github.com/haseebno1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haseebno1/decision-desk.git"
  },
  "homepage": "https://github.com/haseebno1/decision-desk#readme",
  "bugs": {
    "url": "https://github.com/haseebno1/decision-desk/issues"
  },
  "keywords": [
    "decision-making",
    "local-first",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "local-first",
    "decision-journal"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --dry",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "preview": "vite preview",
    "seed:demo": "node scripts/seed-demo-data.mjs --console"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
